{
  "name": "tfm-interop-api",
  "version": "0.1.0",
  "description": "Common API to store, retrieve and verify data on the XRP Ledger and the XRPL EVM (UOC Master's thesis prototype).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "xrpl:setup": "tsx scripts/xrpl-setup.ts",
    "xrpl:smoke": "tsx scripts/xrpl-smoke.ts",
    "evm:smoke": "tsx scripts/evm-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "xrpl": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
