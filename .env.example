# Copy this file to .env and fill in the values. Never commit .env (SR3).
PORT=3000
API_KEYS=change-me-1,change-me-2
REQUEST_MAX_AGE_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
MAX_XRPL_PAYLOAD_BYTES=512
MAX_EVM_PAYLOAD_BYTES=4096

# XRP Ledger: local stand-alone node (ws://127.0.0.1:6006) or XRPL Testnet (wss://s.altnet.rippletest.net:51233)
XRPL_WS_URL=ws://127.0.0.1:6006
XRPL_SEED=
XRPL_ANCHOR_DESTINATION=
# true only for the local stand-alone node (the API closes the ledgers itself)
XRPL_STANDALONE=true

# EVM: local Anvil (http://127.0.0.1:8545, chain id 31337) or XRPL EVM testnet
EVM_RPC_URL=http://127.0.0.1:8545
EVM_PRIVATE_KEY=
EVM_CHAIN_ID=31337
# Written after deploying the contract (see README), with the block of the deployment.
EVM_CONTRACT_ADDRESS=
EVM_FROM_BLOCK=

DB_PATH=./data/api.sqlite
